# Copy to .env next to docker-compose.yml and adjust. Every value is optional.

# user/group that owns files in /config, /cache and new files in /music (match Navidrome's)
PUID=1000
PGID=1000
TZ=Australia/Melbourne

# cap for the streaming engine's torrent cache (e.g. 20GB, 512MiB)
ENGINE_CACHE_SIZE=10GB

# image to run: the local build (default) or your own registry, e.g. registry.lan:5000/stremio-music:1.0.0
# STREMIO_MUSIC_IMAGE=stremio-music:local

# shown as the image revision label; `REVISION=$(git rev-parse --short HEAD) docker compose build`
# REVISION=
