{
  "name": "stremio-music-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 dist/test/*.test.js",
    "test:sources": "node --disable-warning=ExperimentalWarning dist/test/contract/run.js",
    "new-source": "node scripts/new-source.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/http-proxy": "11.6.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "fastify": "5.12.7",
    "music-metadata": "12.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
