{
  "name": "stremio-music-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 dist/test/*.test.js"
  },
  "dependencies": {
    "@fastify/http-proxy": "11.6.4",
    "@fastify/static": "10.1.6",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
