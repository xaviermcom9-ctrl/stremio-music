#!/bin/sh
# User management CLI (see server/src/cli.ts). `docker exec` runs as root by default: drop to
# PUID:PGID so the database files in /config keep the right owner.
set -eu
CLI="node --disable-warning=ExperimentalWarning /app/server/dist/src/cli.js"
if [ "$(id -u)" = "0" ]; then
  exec setpriv --reuid="${PUID:-1000}" --regid="${PGID:-1000}" --clear-groups env HOME=/config $CLI "$@"
fi
exec $CLI "$@"
